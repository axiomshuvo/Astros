---
interface Props {
  title: string;
  description?: string; 
  pubDate: Date;
  url?: string;
}

const { title, description, pubDate, url } = Astro.props as Props;
---

<a href={url} class="card" >
  <h2>{title}</h2>
  <p class="muted">{pubDate.toDateString()}</p>
  {description && <p>{description}</p>}

</a>